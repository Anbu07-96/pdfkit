diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 63bdef4..bb91c9a 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -32,6 +32,12 @@ jobs:
       - name: Lint
         run: npm run lint
 
+      # Next 16: PageProps/LayoutProps globals and route types are generated
+      # into .next/types — typecheck requires them (Phase 64 fix; previously
+      # typecheck ran before build and could not resolve the generated types).
+      - name: Generate route types
+        run: npx next typegen
+
       - name: Typecheck
         run: npm run typecheck
 
@@ -42,3 +48,67 @@ jobs:
         run: npm run build
         env:
           NEXT_TELEMETRY_DISABLED: "1"
+
+  # Phase 64: real-infrastructure integration tests. Mirrors the locally
+  # verified commands (docs/distributed-infrastructure-validation.md):
+  # a real generated Prisma client, an embedded PostgreSQL 16 (npm package,
+  # no docker) and a Redis service container. Runs on every PR/push to main.
+  integration:
+    name: Integration (real PostgreSQL + Redis)
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+
+    services:
+      redis:
+        image: redis:7-alpine
+        ports:
+          - 6399:6379
+        options: >-
+          --health-cmd "redis-cli ping"
+          --health-interval 5s
+          --health-timeout 3s
+          --health-retries 10
+
+    steps:
+      - name: Check out
+        uses: actions/checkout@v4
+
+      - name: Set up Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+
+      - name: Install dependencies
+        run: npm ci
+
+      - name: Generate real Prisma client (replaces the dev stub)
+        run: npx prisma generate
+
+      - name: Validate Prisma schema
+        run: npm run prisma:validate
+        env:
+          DATABASE_URL: postgresql://ci:ci@127.0.0.1:5433/ci
+
+      - name: Boot embedded PostgreSQL and run integration tests
+        run: |
+          node --input-type=module -e "
+            import { startEmbeddedPostgres } from './scripts/infra/postgres.mjs';
+            const pg = await startEmbeddedPostgres({ dataDir: '/tmp/ci-pgdata', port: 5433, database: 'pdfkit_ci' });
+            console.log('CI postgres ready:', pg.url);
+            const { execFileSync } = await import('node:child_process');
+            try {
+              execFileSync('npx', ['vitest', 'run',
+                'src/lib/usage/postgres.integration.test.ts',
+                'src/lib/hardening/redis.integration.test.ts'], {
+                stdio: 'inherit',
+                env: {
+                  ...process.env,
+                  PDFKIT_TEST_DATABASE_URL: pg.url,
+                  PDFKIT_TEST_REDIS_URL: 'redis://127.0.0.1:6399/0',
+                },
+              });
+            } finally {
+              await pg.stop();
+            }
+          "

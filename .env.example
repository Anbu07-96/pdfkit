# PDFKit environment variables
#
# Copy this file to `.env.local` and adjust as needed:
#   cp .env.example .env.local
#
# `.env*` files are git-ignored (except this example). Never commit real
# secrets, API keys or credentials.

# ---------------------------------------------------------------------------
# Public values (exposed to the browser — never put secrets here)
# ---------------------------------------------------------------------------

# Absolute URL of the deployment. Used for metadata, canonical URLs, sitemap
# and robots.txt. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact address shown in the interface. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Processing limits (server-only, optional — safe defaults are used when unset)
# ---------------------------------------------------------------------------
# These bound what a single processing request may do. Because documents are
# processed in memory, they also bound the memory one request can use.

# Maximum number of files in one job. Default: 20
PDFKIT_MAX_FILES_PER_JOB=20

# Maximum size of a single uploaded file, in bytes. Default: 26214400 (25 MB)
PDFKIT_MAX_UPLOAD_SIZE=26214400

# Maximum combined size of one request, in bytes. Default: 104857600 (100 MB)
# Never smaller than PDFKIT_MAX_UPLOAD_SIZE.
PDFKIT_MAX_TOTAL_UPLOAD_SIZE=104857600

# Maximum number of documents one job may produce, for example when splitting
# every page of a long PDF. Checked before any output is generated. Default: 50
PDFKIT_MAX_SPLIT_OUTPUTS=50

# Maximum number of pages the aggressive ("high") compression pass may
# rasterise in one job; above it, high stays lossless. Bounds CPU and memory.
# Default: 60 (hard ceiling 300)
PDFKIT_COMPRESS_MAX_RASTER_PAGES=60

# Maximum number of pages a PDF → JPG/PNG export may render in one job.
# Above it the export is rejected before anything is allocated.
# Default: 50 (hard ceiling 200)
PDFKIT_CONVERSION_MAX_PAGES=50

# Render resolution, in dots per inch, for PDF → JPG/PNG exports. Aspect
# ratios are always preserved; pathological page sizes are guarded regardless.
# Default: 150 (hard ceiling 300)
PDFKIT_CONVERSION_DPI=150

# Maximum size of a single produced JPG/PNG, in bytes. Default: 6291456 (6 MB)
PDFKIT_CONVERSION_MAX_IMAGE_BYTES=6291456

# ---------------------------------------------------------------------------
# Page preview (thumbnail) limits — server-only, optional
# ---------------------------------------------------------------------------
# Page previews are rasterised in memory with pdfium (WebAssembly). These bound
# the work one preview request can do.

# Maximum pages rendered in one request. Default: 60 (hard ceiling 200)
PDFKIT_THUMBNAIL_MAX_PAGES=60

# Rendered width in pixels; height follows the page. Default: 220 (ceiling 600)
PDFKIT_THUMBNAIL_WIDTH=220

# Maximum size of a single produced PNG, in bytes. Default: 500000
# Also applies to rotated previews (Rotate PDF, Extract, Delete, Split).
PDFKIT_THUMBNAIL_MAX_BYTES=500000

# ---------------------------------------------------------------------------
# Server-only secrets (later phases — none are required or read today)
# ---------------------------------------------------------------------------
# OCR, AI, cloud storage and billing are not implemented. When they land, their
# variables belong here WITHOUT the NEXT_PUBLIC_ prefix so they stay on the
# server:
#
# PDFKIT_STORAGE_BUCKET=
# PDFKIT_STORAGE_ACCESS_KEY=
# PDFKIT_OCR_API_KEY=
# PDFKIT_AI_API_KEY=

# PDFKit environment variables
#
# Copy this file to `.env.local` and adjust as needed:
#   cp .env.example .env.local
#
# `.env*` files are git-ignored (except this example). Never commit real
# secrets, API keys or credentials.

# ---------------------------------------------------------------------------
# Public values (exposed to the browser — never put secrets here)
# ---------------------------------------------------------------------------

# Absolute URL of the deployment. Used for metadata, canonical URLs, sitemap
# and robots.txt. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact address shown in the interface. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Processing limits (server-only, optional — safe defaults are used when unset)
# ---------------------------------------------------------------------------
# These bound what a single processing request may do. Because documents are
# processed in memory, they also bound the memory one request can use.

# Maximum number of files in one job. Default: 20
PDFKIT_MAX_FILES_PER_JOB=20

# Maximum size of a single uploaded file, in bytes. Default: 26214400 (25 MB)
PDFKIT_MAX_UPLOAD_SIZE=26214400

# Maximum combined size of one request, in bytes. Default: 104857600 (100 MB)
# Never smaller than PDFKIT_MAX_UPLOAD_SIZE.
PDFKIT_MAX_TOTAL_UPLOAD_SIZE=104857600

# Maximum number of documents one job may produce, for example when splitting
# every page of a long PDF. Checked before any output is generated. Default: 50
PDFKIT_MAX_SPLIT_OUTPUTS=50

# Maximum number of embedded images Extract Images may return from one
# document. Counted before any bytes are extracted, so a crafted PDF with
# thousands of tiny images cannot allocate unbounded memory.
# Default: 200 (hard ceiling 1000)
PDFKIT_EXTRACT_IMAGES_MAX_IMAGES=200

# Maximum number of pages the aggressive ("high") compression pass may
# rasterise in one job; above it, high stays lossless. Bounds CPU and memory.
# Default: 60 (hard ceiling 300)
PDFKIT_COMPRESS_MAX_RASTER_PAGES=60

# Maximum number of pages a PDF → JPG/PNG export may render in one job.
# Above it the export is rejected before anything is allocated.
# Default: 50 (hard ceiling 200)
PDFKIT_CONVERSION_MAX_PAGES=50

# Render resolution, in dots per inch, for PDF → JPG/PNG exports. Aspect
# ratios are always preserved; pathological page sizes are guarded regardless.
# Default: 150 (hard ceiling 300)
PDFKIT_CONVERSION_DPI=150

# Maximum size of a single produced JPG/PNG, in bytes. Default: 6291456 (6 MB)
PDFKIT_CONVERSION_MAX_IMAGE_BYTES=6291456

# ---------------------------------------------------------------------------
# Production hardening — server-only, optional
# ---------------------------------------------------------------------------
# Safety valves around every /api/tools processing route (Phase 28).

# Milliseconds a processing request may take before the caller receives
# 504 REQUEST_TIMEOUT. The job itself is NOT aborted (pdfium work cannot be
# cancelled); its result is discarded once it finishes privately.
# Default: 120000 (2 minutes, hard ceiling 600000)
PDFKIT_REQUEST_TIMEOUT_MS=120000

# Maximum number of jobs processed at the same time in this instance.
# 0 disables the cap (default). When the cap is reached, extra requests fail
# fast with 503 SERVER_BUSY instead of queueing — there is no queue.
# With Redis configured, the cap is GLOBAL across instances.
# Default: 0 (hard ceiling 1024)
PDFKIT_MAX_CONCURRENT_JOBS=0

# Processing requests per minute per client IP (default 60, ceiling 1000).
# With Redis configured, the budget is GLOBAL across instances.
# PDFKIT_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Page preview (thumbnail) limits — server-only, optional
# ---------------------------------------------------------------------------
# Page previews are rasterised in memory with pdfium (WebAssembly). These bound
# the work one preview request can do.

# Maximum pages rendered in one request. Default: 60 (hard ceiling 200)
PDFKIT_THUMBNAIL_MAX_PAGES=60

# Rendered width in pixels; height follows the page. Default: 220 (ceiling 600)
PDFKIT_THUMBNAIL_WIDTH=220

# Maximum size of a single produced PNG, in bytes. Default: 500000
# Also applies to rotated previews (Rotate PDF, Extract, Delete, Split).
PDFKIT_THUMBNAIL_MAX_BYTES=500000

# ---------------------------------------------------------------------------
# Authentication & Accounts — server-only
# ---------------------------------------------------------------------------
# NextAuth / Auth.js configuration (Phase 42).
# Safe defaults are used when unset in local development/tests.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=pdfkit-dev-auth-secret-do-not-use-in-production

# Optional OAuth Provider Credentials
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Production Database & Usage Quotas — server-only (Phase 43)
# ---------------------------------------------------------------------------
# PostgreSQL connection string for usage metering and account persistence.
# In local development/testing without DATABASE_URL, an in-memory repository is used automatically.
# IMPORTANT (Phase 64): when DATABASE_URL is set, the REAL Prisma client must
# be generated (`npx prisma generate`) — the app refuses to start with the
# development stub client and fails closed instead of silently dropping usage
# metering. See docs/staging-deployment.md.
# DATABASE_URL=postgresql://user:password@localhost:5432/pdfkit?schema=public

# Force the in-memory usage repository even when DATABASE_URL is set.
# Development/testing only — never enable in staging/production.
# PDFKIT_USE_IN_MEMORY_USAGE_REPO=false

# ---------------------------------------------------------------------------
# Shared Infrastructure — Redis — server-only (Phase 41/55/64)
# ---------------------------------------------------------------------------
# Redis connection string for the distributed IP rate limit and the global
# concurrency cap. Unset: per-process fallback (single-instance only).
# PDFKIT_REDIS_URL takes precedence over REDIS_URL.
# PDFKIT_REDIS_URL=redis://localhost:6379

# Declare Redis MANDATORY for this deployment (multi-instance staging/prod).
# true + Redis unavailable → requests fail closed (503) and readiness reports
# 503; the protections never silently downgrade to per-process state (which
# would multiply the limits by the instance count). Default: false (dev).
# PDFKIT_REDIS_REQUIRED=false

# Optional Plan Quota Overrides (daily jobs / daily bytes)
# PDFKIT_QUOTA_ANON_DAILY_JOBS=10
# PDFKIT_QUOTA_ANON_DAILY_BYTES=52428800
# PDFKIT_QUOTA_FREE_DAILY_JOBS=50
# PDFKIT_QUOTA_FREE_DAILY_BYTES=262144000
# PDFKIT_QUOTA_PRO_DAILY_JOBS=500
# PDFKIT_QUOTA_PRO_DAILY_BYTES=2147483648
# PDFKIT_QUOTA_BUSINESS_DAILY_JOBS=5000
# PDFKIT_QUOTA_BUSINESS_DAILY_BYTES=21474836480

# ---------------------------------------------------------------------------
# Production Observability — server-only (Phase 63)
# ---------------------------------------------------------------------------
# Admin metrics endpoint token. UNSET = /api/admin/metrics is disabled (404).
# Set a long random string in production; present it as
# `Authorization: Bearer <token>` or `x-pdfkit-admin-token`.
# PDFKIT_ADMIN_METRICS_TOKEN=

# Sanitized environment label included in telemetry snapshots (letters,
# digits, dots, dashes; anything else is replaced with "unknown").
# PDFKIT_ENVIRONMENT=production

# Metrics provider selection. Only "in-memory" exists today; unknown values
# fall back to in-memory with a warning (telemetry fails open, never the app).
# PDFKIT_METRICS_PROVIDER=in-memory

# ---------------------------------------------------------------------------
# Razorpay Billing — server-only (Phase 46C)
# ---------------------------------------------------------------------------
# Razorpay API key ID, secret, webhook secret, and Pro plan ID for PRO plan upgrade.
# Leave empty in local development to run in unconfigured/free mode.
# Never commit real API keys or webhook secrets to repository.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=

# ---------------------------------------------------------------------------
# Server-only secrets (later phases — none are required or read today)
# ---------------------------------------------------------------------------
# OCR, AI, cloud storage and billing are not implemented. When they land, their
# variables belong here WITHOUT the NEXT_PUBLIC_ prefix so they stay on the
# server:
#
# PDFKIT_STORAGE_BUCKET=
# PDFKIT_STORAGE_ACCESS_KEY=
# PDFKIT_OCR_API_KEY=
# PDFKIT_AI_API_KEY=

# ---------------------------------------------------------------------------
# Billing operating mode (Phase 66)
# ---------------------------------------------------------------------------

# Razorpay keys are detected automatically: rzp_test_… → test mode,
# rzp_live_… → live mode. Live mode ADDITIONALLY requires this explicit
# acknowledgment — without it the stack runs billing-disabled even if live
# keys are present (fail-closed). Leave unset unless launching live billing.
PDFKIT_BILLING_ALLOW_LIVE=

# ---------------------------------------------------------------------------
# Transactional email (Phase 66) — verification + password-reset delivery
# ---------------------------------------------------------------------------

# SMTP_HOST enables real delivery (any provider). Without it, development
# logs verification links and password reset returns a clear failure in
# production. Names only here — never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# OAuth (Phase 66) — providers load only when both variables for one exist
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
